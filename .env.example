# ===========================================
# Project-103 Trading Bot - Environment Variables
# ===========================================

# ===========================================
# Exchange API Keys
# ===========================================

# Bybit Production
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Bybit Testnet
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Binance Production
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# MT5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ===========================================
# Database & Cache Credentials
# ===========================================

# PostgreSQL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/project103

# Redis
# Format: redis://[[username:]password@]host:port/db
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# Notification Credentials
# ===========================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAILS=

# Slack Webhook
WEBHOOK_URL=

# ===========================================
# Monitoring Services Credentials
# ===========================================

# Grafana API Key
GRAFANA_API_KEY=

# Sentry DSN for error tracking
SENTRY_DSN=

# ===========================================
# Google Sheets (Live Trade Export)
# ===========================================
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=config/google_sheets_credentials.json

# ===========================================
# Knowledge Management (Obsidian)
# ===========================================

# Path to Obsidian vault for trading knowledge
# Used by: run_backtest.py --note, generate_obsidian_notes.py --vault
TRADING_VAULT_PATH=

# ===========================================
# Security Secrets
# ===========================================

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# ===========================================
# Multi-Account Encryption
# ===========================================
# Key for encrypting API keys in accounts.yaml
# Generate with: python -c "from cryptography.fernet import Fernet;
print(Fernet.generate_key().decode())"
ACCOUNTS_ENCRYPTION_KEY=